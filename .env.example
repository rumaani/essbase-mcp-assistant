# --- Essbase MCP endpoint ---
# Live 26ai:  https://<host>/essbase/rest/v1/ess-mcp
# Local mock: http://localhost:9100/essbase/rest/v1/ess-mcp
ESSBASE_MCP_URL=http://localhost:9100/essbase/rest/v1/ess-mcp
ESSBASE_PROFILE=viewer          # viewer | analyst | admin

# --- Auth ---
AUTH_MODE=client_credentials    # client_credentials | token | none
OAUTH_TOKEN_URL=http://localhost:9100/oauth2/v1/token
OAUTH_CLIENT_ID=essbase-assistant
OAUTH_CLIENT_SECRET=change-me
OAUTH_SCOPE=urn:opc:idm:__myscopes__
# ACCESS_TOKEN=                 # used when AUTH_MODE=token

# --- Query understanding ---
LLM_PROVIDER=none               # none | openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama, LM Studio, OpenAI
# LLM_MODEL=llama3.1
# LLM_API_KEY=

CONTEXT_FILE=contexts/Sample.Basic.yaml
