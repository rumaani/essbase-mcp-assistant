# Optional. Settings saved in the Admin tab (data/settings.json) take precedence over these.

EMCP_MODE=mock                  # mock = built-in mock server | remote = real Essbase 26ai

# --- Essbase 26ai MCP endpoint (remote mode) ---
ESSBASE_MCP_URL=https://<host>/essbase/rest/v1/ess-mcp
ESSBASE_PROFILE=viewer          # viewer | analyst | admin
VERIFY_TLS=true

# --- Auth (OCI IAM identity domain) ---
AUTH_MODE=client_credentials    # client_credentials | token | none
OAUTH_TOKEN_URL=https://<identity-domain>.identity.oraclecloud.com/oauth2/v1/token
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_SCOPE=urn:opc:idm:__myscopes__
# ACCESS_TOKEN=                 # used when AUTH_MODE=token

# --- Who Essbase sees ---
IDENTITY_MODE=shared            # shared = one service account | per_user = each person signs in
# OAUTH_AUTHORIZE_URL=          # per_user; default: token URL with /authorize
# OAUTH_REDIRECT_URL=           # per_user; default: <this app>/auth/callback (set behind a proxy)
OAUTH_USER_SCOPE=urn:opc:idm:__myscopes__ openid offline_access
SESSION_HOURS=8                 # idle sign-out
SSO_PROVIDER=identity_domain    # identity_domain | entra (Entra ID federated with the domain)
AUTO_SIGNIN=false               # true: send people to sign-in automatically (no clicks with SSO)
# SIGNOUT_URL=                  # optional: also end the SSO session after app sign-out

# --- Query understanding ---
LLM_PROVIDER=none               # none | openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1   # Ollama, LM Studio, OpenAI, ...
# LLM_MODEL=llama3.1
# LLM_API_KEY=

# --- Capacity (all users share one Essbase connection) ---
MAX_CONCURRENT_CALLS=20         # parallel Essbase calls; the rest queue
QUEUE_TIMEOUT_S=30              # then the user sees "busy, try again"
REQUEST_TIMEOUT_S=60
MAX_MEMBERS_PER_DIMENSION=5000  # cached per dimension; the rest are looked up
# EMCP_WEB_THREADS=128          # web request threads
# EMCP_MOCK_LATENCY_MS=200      # make the built-in mock as slow as a real server

# --- Storage ---
CONTEXT_DIR=contexts
ACTIVE_CUBE=Sample.Basic
EMCP_DATA_DIR=data
# EMCP_SECRET_KEY=              # Fernet key; else generated into data/secret.key
# EMCP_ADMIN_PASSWORD=          # protect the Admin tab / API
